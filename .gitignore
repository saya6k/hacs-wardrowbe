# Whitelist .gitignore — default-deny. Ignore everything at the top level,
# then re-include only the paths that belong in the repo. New/untracked junk
# and the local dev `config/` are therefore never committed by accident.
/*

# Tracked directories
!/.github/
!/.devcontainer/
!/custom_components/
!/docs/
!/scripts/

# Tracked top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/README.md
!/hacs.json
!/zensical.en.toml
!/zensical.ko.toml

# Agent scaffolding (AGENTS.md, .agents/, .claude/, .gemini, CLAUDE.md /
# GEMINI.md symlinks) is local-only and never tracked — it falls under the
# default-deny `/*` above and is listed here only for discoverability.

# Noise inside tracked directories
__pycache__/
*.py[cod]
.DS_Store

# Repo-specific tracked extras
!/pyproject.toml
!/tests/
